{
  "manifest_version": 3,
  "name": "엔트리 작품 줄여 저장",
  "version": "1.0",
  "description": "엔트리 온라인 만들기 화면에서 저장할 때 블록의 기본값을 빼서 작품 크기를 절반쯤으로 줄입니다.",
  "content_scripts": [
    {
      "matches": ["https://playentry.org/*", "https://space.playentry.org/*"],
      "js": ["slim.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
