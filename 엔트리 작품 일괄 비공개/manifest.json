{
  "manifest_version": 3,
  "name": "엔트리 작품 일괄 비공개",
  "version": "1.0.0",
  "description": "playentry.org 마이페이지에서 고른 작품을 한꺼번에 비공개로 바꿉니다.",
  "content_scripts": [
    {
      "matches": ["https://playentry.org/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
